<%- include("./Layouts/header", { user: user }) %>

<!-- Start Container Fluid -->
<div class="page-content">
  <div class="container-fluid">
    <!-- Page Title -->
    <div class="row">
      <div class="col-12">
        <div class="page-title-box">
          <h4 class="mb-0 fw-semibold">Deep Search for Files & Folders</h4>
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="#">DMS</a></li>
            <li class="breadcrumb-item active">Search Files & Folders</li>
          </ol>
        </div>
      </div>
    </div>

    <!-- Search and Results -->
    <div class="row">
      <div class="col-xl-12">
        <div class="card">
          <div class="card-body">

            <!-- Search Form -->
            <form method="GET" action="/DeepSearch" id="documentSearchForm" class="mb-4">
              <input type="hidden" name="searchMode" id="searchMode" value="quick">
              <div class="document-search" id="documentSearch">
                <div class="document-search__icon" aria-hidden="true">
                  <i class="bx bx-search"></i>
                </div>
                <input
                  type="search"
                  class="document-search__input"
                  name="keyword"
                  value="<%= keyword || '' %>"
                  aria-label="Search files and folders"
                  placeholder="Search files / folders">
                <select class="document-search__mode" id="documentSearchMode" aria-label="Search mode">
                  <option value="quick" selected>Quick Search</option>
                  <option value="advanced">Advanced Search</option>
                </select>
              </div>
              <p id="quickSearchHint" class="text-muted small mt-2 mb-0">Quick search is faster but may not search within document content.</p>
              <p class="text-muted small mt-2 mb-0 d-none" id="advancedSearchHint">
                Advanced search helps to search user with document content, but it may take longer time to fetch results. Please be patient while the search is in progress.
              </p>
            </form>

            <!-- Search Results Table -->
            <div class="table-responsive">
              <table class="table align-middle mb-0 table-hover table-centered">
                <thead class="bg-light-subtle">
                  <tr>
                    <th>SI No.</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Upload Date</th>
                    <th>Uploaded By</th>
                    <th>Department</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="folderTableBody">
                  <% if (!matches || matches.length === 0) { %>
                    <tr>
                      <td colspan="7" class="text-center">No matching files or folders found.</td>
                    </tr>
                  <% } else { %>
                    <% matches.forEach((item, index) => { %>
                      <tr>
                        <td><%= index + 1 %></td>
                        <td><%= item.name %></td>
                        <td><%= item.type %></td>
                        <td><%= new Date(item.date).toLocaleDateString() %></td>
                        <td><%= item.uploadedBy || "N/A" %></td>
                        <td><%= item.department || "N/A" %></td>
                        <td>
                          <% if (item.type === "file") { %>
                             <iconify-icon icon="material-symbols:download" class="align-middle fs-18"></iconify-icon>
                            <a href="/download/<%= item._id %>" >Download</a>
                          <% } else { %>
                            -
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .document-search {
    align-items: center;
    background: #fff;
    border: 2px solid #b3b3b3;
    border-radius: 10px;
    display: flex;
    min-height: 60px;
    padding: 8px 14px;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .document-search:focus-within {
    border-color: #6c757d;
    box-shadow: 0 0 0 .2rem rgba(108, 117, 125, .12);
  }

  .document-search__icon {
    color: #8a8a8a;
    font-size: 24px;
    line-height: 1;
    margin: 0 14px 0 2px;
  }

  .document-search__input {
    background: transparent;
    border: 0;
    color: #4b4b4b;
    flex: 1;
    font-size: clamp(1rem, 1.5vw, 1rem);
    min-width: 0;
    outline: 0;
  }

  .document-search__input::placeholder { color: #858585; opacity: 1; }

  .document-search__mode {
    appearance: auto;
    background: #f5f5f5;
    border: 0;
    border-radius: 999px;
    color: #6c6c6c;
    cursor: pointer;
    font-size: .9rem;
    margin-left: 12px;
    padding: 8px 14px;
    width: 155px;
  }

  @media (max-width: 575.98px) {
    .document-search { flex-wrap: wrap; min-height: auto; }
    .document-search__icon { font-size: 24px; margin-right: 10px; }
    .document-search__input { font-size: 1rem; }
    .document-search__mode { margin: 10px 0 0 34px; width: calc(100% - 34px); }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const mode = document.getElementById("documentSearchMode");
    const modeInput = document.getElementById("searchMode");
    const input = document.querySelector(".document-search__input");
    const quickHint = document.getElementById("quickSearchHint");
    const advancedHint = document.getElementById("advancedSearchHint");

    mode.addEventListener("change", function () {
      const isQuickSearch = mode.value === "quick";
      modeInput.value = mode.value;
      quickHint.classList.toggle("d-none", !isQuickSearch);
      advancedHint.classList.toggle("d-none", isQuickSearch);
      input.placeholder = isQuickSearch ? "Search files / folders" : "Advanced Search";
      input.setAttribute("aria-label", isQuickSearch ? "Search files and folders" : "Advanced search");
      input.focus();
    });
  });
</script>

<%- include("./Layouts/footer") %>
