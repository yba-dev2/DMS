<%- include("./Layouts/header", { user }) %>

<div class="page-content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="page-title-box">
          <h4 class="mb-0 fw-semibold">My Profile</h4>
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/welcome">DMS</a></li>
            <li class="breadcrumb-item active">Profile</li>
          </ol>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-9">
        <div class="card overflow-hidden">
          <div class="card-body p-0">
            <div class="bg-primary bg-gradient" style="height: 100px;"></div>

            <div class="px-4 pb-4">
              <div class="d-flex flex-column flex-md-row align-items-md-end gap-3" style="margin-top: -48px;">
                <img
                  src="/assets/images/users/dummy-avatar.jpg"
                  class="rounded-circle border border-4 border-white shadow-sm bg-white"
                  width="112"
                  height="112"
                  alt="Default profile avatar"
                >
                <div class="pb-md-2">
                  <h3 class="mb-1"><%= user.name || "Not available" %></h3>
                  <p class="text-muted mb-0"><%= user.department || "Department not available" %></p>
                </div>
              </div>

              <hr class="my-4">

              <div class="row g-4">
                <div class="col-md-6">
                  <div class="border rounded p-3 h-100">
                    <p class="text-muted mb-1">Employee ID</p>
                    <h5 class="mb-0"><%= user.employeeId || "Not available" %></h5>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="border rounded p-3 h-100">
                    <p class="text-muted mb-1">Employee Code</p>
                    <h5 class="mb-0"><%= user.employeeCode || "Not available" %></h5>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="border rounded p-3 h-100">
                    <p class="text-muted mb-1">Email Address</p>
                    <h5 class="mb-0 text-break"><%= user.email || "Not available" %></h5>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="border rounded p-3 h-100">
                    <p class="text-muted mb-1">Department</p>
                    <h5 class="mb-0"><%= user.department || "Not available" %></h5>
                  </div>
                </div>
              </div>

              <div class="alert alert-light border mt-4 mb-0" role="note">
                Profile details are provided by ERP and cannot be edited from DMS.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("./Layouts/footer") %>
